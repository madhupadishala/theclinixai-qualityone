generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  SUPERSEDED
  RETIRED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum QualificationStatus {
  NOT_STARTED
  IN_PROGRESS
  QUALIFIED
  AT_RISK
  EXPIRED
  SUSPENDED
}

enum SignatureMeaning {
  AUTHOR
  REVIEW
  APPROVAL
  ACKNOWLEDGEMENT
  COMPLETION
  QUALIFICATION
  QMS_APPROVAL
  QMS_CLOSURE
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SCENARIO
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

enum PracticalObservationStatus {
  PENDING
  PASSED
  FAILED
}

enum DeviationStatus {
  OPEN
  UNDER_INVESTIGATION
  RCA_COMPLETED
  CAPA_IN_PROGRESS
  EFFECTIVENESS_PENDING
  READY_FOR_CLOSURE
  CLOSED
  VOID
}

enum DeviationSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum RootCauseCategory {
  PEOPLE
  PROCESS
  PROCEDURE
  TECHNOLOGY
  TRAINING
  MATERIAL
  ENVIRONMENT
  DATA
  OTHER
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  EFFECTIVE
  INEFFECTIVE
  CLOSED
  CANCELLED
}

enum EffectivenessOutcome {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

model Tenant {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  memberships   Membership[]
  departments   Department[]
  jobRoles      JobRole[]
  roles         Role[]
  documents     Document[]
  curricula     Curriculum[]
  assessments   Assessment[]
  deviations    Deviation[]
  capAs         Capa[]
  auditEvents   AuditEvent[]
}

model Organization {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  code        String
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  displayName       String
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       Membership[]
  signatures        ElectronicSignature[]
  auditEvents       AuditEvent[]           @relation("AuditActor")
  assessedPractical PracticalObservation[] @relation("PracticalAssessor")
  deviationOwners   Deviation[]            @relation("DeviationOwner")
  investigators     Investigation[]        @relation("Investigator")
  rcaAuthors        RootCauseAnalysis[]    @relation("RcaAuthor")
  capaOwners        Capa[]                 @relation("CapaOwner")
  effectivenessBy   EffectivenessCheck[]   @relation("EffectivenessReviewer")
}

model Department {
  id             String       @id @default(cuid())
  tenantId       String
  organizationId String
  name           String
  code           String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  deviations     Deviation[]
  @@unique([tenantId, organizationId, code])
  @@index([tenantId])
}

model JobRole {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  curricula   Curriculum[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Membership {
  id                    String                 @id @default(cuid())
  tenantId              String
  userId                String
  departmentId          String?
  jobRoleId             String?
  status                MembershipStatus       @default(INVITED)
  createdAt             DateTime               @default(now())
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobRole               JobRole?               @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  roleGrants            MembershipRole[]
  assignments           TrainingAssignment[]
  trainingRecords       TrainingRecord[]
  assessmentAttempts    AssessmentAttempt[]
  practicalObservations PracticalObservation[]
  qualifications        Qualification[]
  @@unique([tenantId, userId])
  @@index([tenantId, status])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  code        String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  grants      MembershipRole[]
  permissions RolePermission[]
  @@unique([tenantId, code])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([membershipId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  occurredAt  DateTime @default(now())
  action      String
  entityType  String
  entityId    String
  reason      String?
  before      Json?
  after       Json?
  metadata    Json?
  prevHash    String?
  eventHash   String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
}

model ElectronicSignature {
  id               String           @id @default(cuid())
  userId           String
  meaning          SignatureMeaning
  signedAt         DateTime         @default(now())
  entityType       String
  entityId         String
  statement        String
  contentHash      String
  ipAddress        String?
  userAgent        String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  trainingRecord   TrainingRecord?
  qualification    Qualification?   @relation("QualificationSignature")
  deviationClosure Deviation?       @relation("DeviationClosureSignature")
  @@index([entityType, entityId])
}

model Document {
  id               String            @id @default(cuid())
  tenantId         String
  documentNumber   String
  title            String
  type             String
  status           DocumentStatus    @default(DRAFT)
  currentVersionId String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[] @relation("DocumentVersions")
  currentVersion   DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  curriculumItems  CurriculumItem[]
  @@unique([tenantId, documentNumber])
  @@index([tenantId, status])
}

model DocumentVersion {
  id              String           @id @default(cuid())
  documentId      String
  version         Int
  contentHash     String
  storageKey      String
  changeSummary   String?
  effectiveAt     DateTime?
  supersededAt    DateTime?
  createdAt       DateTime         @default(now())
  document        Document         @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor      Document?        @relation("CurrentDocumentVersion")
  curriculumItems CurriculumItem[]
  trainingRecords TrainingRecord[]
  @@unique([documentId, version])
}

model Curriculum {
  id                String               @id @default(cuid())
  tenantId          String
  jobRoleId         String?
  code              String
  title             String
  version           Int                  @default(1)
  active            Boolean              @default(true)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobRole           JobRole?             @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  items             CurriculumItem[]
  assignments       TrainingAssignment[]
  assessments       Assessment[]
  qualificationRule QualificationRule?
  qualifications    Qualification[]
  @@unique([tenantId, code, version])
}

model CurriculumItem {
  id                String           @id @default(cuid())
  curriculumId      String
  documentId        String?
  documentVersionId String?
  sequence          Int
  required          Boolean          @default(true)
  passingScore      Int?
  curriculum        Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  document          Document?        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  trainingRecords   TrainingRecord[]
  @@unique([curriculumId, sequence])
}

model TrainingAssignment {
  id                    String                 @id @default(cuid())
  membershipId          String
  curriculumId          String
  status                AssignmentStatus       @default(ASSIGNED)
  assignedAt            DateTime               @default(now())
  dueAt                 DateTime?
  completedAt           DateTime?
  score                 Decimal?               @db.Decimal(5, 2)
  membership            Membership             @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  curriculum            Curriculum             @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  records               TrainingRecord[]
  assessmentAttempts    AssessmentAttempt[]
  practicalObservations PracticalObservation[]
  @@index([membershipId, status])
}

model TrainingRecord {
  id                String              @id @default(cuid())
  assignmentId      String
  curriculumItemId  String
  membershipId      String
  documentVersionId String
  signatureId       String              @unique
  completedAt       DateTime            @default(now())
  evidenceHash      String
  assignment        TrainingAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  curriculumItem    CurriculumItem      @relation(fields: [curriculumItemId], references: [id], onDelete: Restrict)
  membership        Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  documentVersion   DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  signature         ElectronicSignature @relation(fields: [signatureId], references: [id], onDelete: Restrict)
  @@unique([assignmentId, curriculumItemId])
  @@index([membershipId, completedAt])
}

model Assessment {
  id            String   @id @default(cuid())
  tenantId      String
  curriculumId  String
  code          String
  title         String
  passingScore  Int      @default(80)
  maxAttempts   Int      @default(3)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  questions     AssessmentQuestion[]
  attempts      AssessmentAttempt[]
  @@unique([tenantId, code])
  @@index([tenantId, curriculumId])
}

model AssessmentQuestion {
  id            String       @id @default(cuid())
  assessmentId  String
  sequence      Int
  type          QuestionType
  prompt        String
  options       Json?
  correctAnswer Json
  points        Decimal      @default(1) @db.Decimal(8, 2)
  rationale     String?
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses     AssessmentResponse[]
  @@unique([assessmentId, sequence])
}

model AssessmentAttempt {
  id            String                  @id @default(cuid())
  assessmentId  String
  assignmentId  String
  membershipId  String
  attemptNumber Int
  status        AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime                @default(now())
  submittedAt   DateTime?
  score         Decimal?                @db.Decimal(5, 2)
  passed        Boolean?
  assessment    Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assignment    TrainingAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  membership    Membership              @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  responses     AssessmentResponse[]
  @@unique([assessmentId, membershipId, attemptNumber])
  @@index([membershipId, assessmentId])
}

model AssessmentResponse {
  id            String             @id @default(cuid())
  attemptId     String
  questionId    String
  answer        Json
  correct       Boolean?
  pointsAwarded Decimal?           @db.Decimal(8, 2)
  attempt       AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@unique([attemptId, questionId])
}

model PracticalObservation {
  id             String                     @id @default(cuid())
  assignmentId   String
  membershipId   String
  assessorUserId String
  competencyCode String
  sampleCount    Int                        @default(1)
  qualityScore   Decimal                    @db.Decimal(5, 2)
  status         PracticalObservationStatus
  notes          String?
  evidenceRef    String?
  observedAt     DateTime                   @default(now())
  assignment     TrainingAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  membership     Membership                 @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  assessor       User                       @relation("PracticalAssessor", fields: [assessorUserId], references: [id], onDelete: Restrict)
  @@index([membershipId, competencyCode, observedAt])
}

model QualificationRule {
  id                      String     @id @default(cuid())
  curriculumId            String     @unique
  knowledgeMinScore       Decimal?   @db.Decimal(5, 2)
  practicalMinScore       Decimal?   @db.Decimal(5, 2)
  minimumSamples          Int        @default(0)
  requireTrainingComplete Boolean    @default(true)
  requireSmeSignoff       Boolean    @default(true)
  validityDays            Int?
  curriculum              Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
}

model Qualification {
  id                 String               @id @default(cuid())
  membershipId       String
  curriculumId       String
  status             QualificationStatus  @default(NOT_STARTED)
  qualifiedAt        DateTime?
  validUntil         DateTime?
  lastEvaluatedAt    DateTime?
  signoffSignatureId String?              @unique
  evidenceSnapshot   Json?
  membership         Membership           @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  curriculum         Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  signoffSignature   ElectronicSignature? @relation("QualificationSignature", fields: [signoffSignatureId], references: [id], onDelete: Restrict)
  @@unique([membershipId, curriculumId])
}

model Deviation {
  id                     String              @id @default(cuid())
  tenantId               String
  deviationNumber        String
  title                  String
  description            String
  severity               DeviationSeverity
  status                 DeviationStatus     @default(OPEN)
  departmentId           String?
  ownerUserId            String
  discoveredAt           DateTime
  dueAt                  DateTime?
  immediateAction        String?
  closedAt               DateTime?
  closureSummary         String?
  closureSignatureId     String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department             Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner                  User                 @relation("DeviationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  investigation          Investigation?
  rootCauseAnalysis      RootCauseAnalysis?
  capas                  Capa[]
  closureSignature       ElectronicSignature? @relation("DeviationClosureSignature", fields: [closureSignatureId], references: [id], onDelete: Restrict)
  @@unique([tenantId, deviationNumber])
  @@index([tenantId, status, severity])
}

model Investigation {
  id               String    @id @default(cuid())
  deviationId      String    @unique
  investigatorId   String
  scope            String
  facts            String
  impactAssessment String?
  evidence         Json?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deviation        Deviation @relation(fields: [deviationId], references: [id], onDelete: Restrict)
  investigator     User      @relation("Investigator", fields: [investigatorId], references: [id], onDelete: Restrict)
}

model RootCauseAnalysis {
  id            String            @id @default(cuid())
  deviationId   String            @unique
  authorUserId  String
  category      RootCauseCategory
  rootCause     String
  contributing  String?
  method        String?
  evidence      Json?
  completedAt   DateTime          @default(now())
  deviation     Deviation         @relation(fields: [deviationId], references: [id], onDelete: Restrict)
  author        User              @relation("RcaAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
}

model Capa {
  id                  String               @id @default(cuid())
  tenantId            String
  deviationId         String
  capaNumber          String
  type                CapaType
  title               String
  action              String
  rationale           String?
  ownerUserId         String
  status              CapaStatus           @default(OPEN)
  dueAt               DateTime?
  completedAt         DateTime?
  verificationSummary String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deviation           Deviation            @relation(fields: [deviationId], references: [id], onDelete: Restrict)
  owner               User                 @relation("CapaOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  effectivenessChecks EffectivenessCheck[]
  @@unique([tenantId, capaNumber])
  @@index([tenantId, status])
  @@index([deviationId])
}

model EffectivenessCheck {
  id             String               @id @default(cuid())
  capaId         String
  reviewerUserId String
  plannedAt      DateTime?
  performedAt    DateTime             @default(now())
  outcome        EffectivenessOutcome
  evidence       String
  notes          String?
  capa           Capa                 @relation(fields: [capaId], references: [id], onDelete: Restrict)
  reviewer       User                 @relation("EffectivenessReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  @@index([capaId, performedAt])
}
